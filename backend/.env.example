# =============================================================================
# Railway (Strapi backend) — required in production
# Copy to backend/.env for local use, or set each variable in Railway dashboard.
# Generate secrets: openssl rand -base64 32
# =============================================================================

# Server (Railway sets PORT automatically; do not hardcode in Railway)
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Public URL of this Strapi service (Railway domain, no trailing slash)
URL=https://your-backend.up.railway.app

# Comma-separated browser origins allowed to call Strapi (no trailing slashes).
# Include every public frontend URL: Vercel default domain, custom domain, and local dev.
FRONTEND_URL=https://your-frontend.vercel.app,https://www.your-domain.com,http://localhost:3000

# Optional: set explicitly if you prefer a dedicated production-only variable.
# VERCEL_PRODUCTION_URL=https://your-frontend.vercel.app

# Required secrets — replace every placeholder before deploying
APP_KEYS=replace-me-key-1,replace-me-key-2
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Database — use Postgres on Railway (do not use sqlite in production)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host:5432/railway
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional Postgres overrides (usually not needed when DATABASE_URL is set)
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SCHEMA=public

# Optional Strapi admin (defaults work when URL is set)
# STRAPI_TELEMETRY_DISABLED=true

# =============================================================================
# Local development only (sqlite)
# =============================================================================
# NODE_ENV=development
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
# FRONTEND_URL=http://localhost:3000
# URL=http://localhost:1337
# Set to true once to seed Homepage hero + stats for ar/en (safe: skips if already present)
# SEED_HOMEPAGE_HERO_STATS=true
# Set to true once to seed Site Config navbar/footer for ar/en (safe: skips if already present)
# SEED_SITE_CONFIG=true

# =============================================================================
# Strapi API token for frontend admin uploads (set on Vercel, NOT on Railway)
# =============================================================================
# Create in Strapi Admin → Settings → API Tokens.
# Custom token permissions (Public role can stay read-only):
#   upload: create
#   forum-document: create, publish
# Then set the same token as STRAPI_API_TOKEN in Vercel / frontend/.env.local
