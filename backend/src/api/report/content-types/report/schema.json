{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Report",
    "description": "PDF reports and policy documents"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "sector": {
      "type": "string",
      "required": true
    },
    "language": {
      "type": "enumeration",
      "enum": ["ar", "en"],
      "default": "ar",
      "required": true
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["files"]
    },
    "publishedOn": {
      "type": "date"
    }
  }
}