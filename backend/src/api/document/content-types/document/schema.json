{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document",
    "description": "PDF documents published by the forum"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "sector": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "locale": {
      "type": "enumeration",
      "enum": ["ar", "en"],
      "default": "en",
      "required": true
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["files"]
    }
  }
}
