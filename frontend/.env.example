# =============================================================================
# Vercel (Next.js frontend) — set in Vercel Project → Settings → Environment Variables
# Copy to frontend/.env.local for local development (never commit .env.local).
# =============================================================================

# Public Strapi API base URL (Railway backend domain, no trailing slash)
NEXT_PUBLIC_STRAPI_URL=https://your-backend.up.railway.app

# Public site URL for metadata, Open Graph, and canonical links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# Server-only Strapi API token for protected admin uploads (never expose as NEXT_PUBLIC_)
# Create in Strapi Admin → Settings → API Tokens (Full access or custom: upload + forum-document)
STRAPI_API_TOKEN=replace-me

# =============================================================================
# Local development
# =============================================================================
# NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
